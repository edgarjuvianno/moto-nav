<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:fillColor="#00000000"
                android:pathData="M32,66 A24,24 0 1,1 76,66"
                android:strokeWidth="7"
                android:strokeColor="#FF262D36"
                android:strokeLineCap="round" />
            <path
                android:name="arc"
                android:fillColor="#00000000"
                android:pathData="M32,66 A24,24 0 1,1 76,66"
                android:strokeWidth="7"
                android:strokeColor="#FFFFB300"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="needle"
                android:pivotX="54"
                android:pivotY="57"
                android:rotation="-125">
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M51.5,57 L54,33 L56.5,57 Z" />
            </group>
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,52 a5,5 0 1,1 0,10 a5,5 0 1,1 0,-10 z" />
            <path
                android:fillColor="#FFFFB300"
                android:pathData="M54,55 a2,2 0 1,1 0,4 a2,2 0 1,1 0,-4 z" />
        </vector>
    </aapt:attr>
    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="700"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="needle">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="700"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="rotation"
                    android:valueFrom="-125"
                    android:valueTo="95"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="95"
                    android:valueTo="35"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
